# ==========================================
# Robinhood Agentic Trading Configuration
# ==========================================

# Google Gemini API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Execution Mode: "autonomous" (hands-free execution) or "supervised" (requires human approval)
EXECUTION_MODE=autonomous

# Risk & Safety Controls
DRY_RUN=true
MAX_ORDER_USD=100.0
DAILY_TRADE_LIMIT_USD=500.0

# Asset Whitelist (comma-separated list of approved stock symbols)
ASSET_WHITELIST=SPY,QQQ,AAPL,NVDA,TSLA

# Autonomous Strategy Loop Interval in seconds (e.g., 300 = 5 minutes)
STRATEGY_INTERVAL_SECONDS=300

# Robinhood MCP Endpoint (accessed via npx mcp-remote)
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading

# Server Host and Port
HOST=0.0.0.0
PORT=8000
